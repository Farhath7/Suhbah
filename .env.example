GMAIL_USER=suhbah.connect@gmail.com
# Generate a Google App Password with 2-Step Verification enabled.
# Put the real value in .env or your hosting provider's secret settings.
GMAIL_APP_PASSWORD=

# Production: attach a persistent disk at /var/data, then set this to /var/data/suhbah.
# Leave empty locally to keep using ./data. A directory on ephemeral storage is not durable.
SUHBAH_DATA_DIR=
